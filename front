<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>DevTasks</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#e9eef3; --panel:#f8fafc; --ink:#14212b; --mute:#5b6b78; --line:#c5d0d9;
  --accent:#2c46e8; --accent-ink:#fff; --done:#1b7f64; --danger:#b3261e;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#10161c; --panel:#18212a; --ink:#e6edf3; --mute:#97a6b3; --line:#2b3a47;
    --accent:#7d8dff; --accent-ink:#10161c; --done:#4fd1a8; --danger:#ff8a80; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#10161c; --panel:#18212a; --ink:#e6edf3; --mute:#97a6b3; --line:#2b3a47;
  --accent:#7d8dff; --accent-ink:#10161c; --done:#4fd1a8; --danger:#ff8a80; color-scheme:dark;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.5 "Familjen Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:640px;margin:0 auto;padding:2.5rem 1.25rem 4rem}
h1{font-size:clamp(2.6rem,9vw,4rem);line-height:1;letter-spacing:-.03em;margin:0 0 .5rem;font-weight:700}
.sub{margin:0 0 2rem;color:var(--mute);max-width:46ch}
.add{display:flex;gap:.5rem}
input{flex:1;min-width:0;font:inherit;color:var(--ink);background:var(--panel);border:1.5px solid var(--line);border-radius:6px;padding:.75rem .9rem}
input::placeholder{color:var(--mute)}
button{font:inherit;font-weight:500;cursor:pointer;border-radius:6px;border:1.5px solid var(--line);background:transparent;color:var(--ink);padding:.45rem .8rem}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);padding:.75rem 1.2rem;font-weight:700}
button:hover:not(:disabled){border-color:var(--accent)}
button:disabled{opacity:.45;cursor:not-allowed}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.status{min-height:1.5rem;margin:.75rem 0 1.25rem;font-size:.95rem;color:var(--mute)}
.status.err{color:var(--danger)}
.count{display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid var(--ink);padding-bottom:.5rem;margin-bottom:.25rem}
.count h2{margin:0;font-size:1.2rem}
.count span{color:var(--mute);font-size:.9rem}
ul{list-style:none;margin:0;padding:0}
li{display:grid;grid-template-columns:3rem 1fr auto;gap:.25rem .75rem;align-items:center;padding:.85rem 0;border-bottom:1px solid var(--line)}
.n{font-weight:700;color:var(--mute);font-variant-numeric:tabular-nums}
.t{overflow-wrap:anywhere}
.s{display:block;font-size:.85rem;color:var(--mute)}
li.done .t{text-decoration:line-through;color:var(--mute)}
li.done .s{color:var(--done);font-weight:700}
.acts{display:flex;gap:.4rem}
.empty{padding:2rem 0;color:var(--mute)}
@media (max-width:480px){li{grid-template-columns:2.4rem 1fr}.acts{grid-column:2}}
@media (prefers-reduced-motion:no-preference){button{transition:border-color .15s}}
</style>
</head>
<body>
<main>
  <h1>DevTasks</h1>
  <p class="sub">Gerenciador de tarefas. Adicione, conclua e remova tarefas, como no programa em C.</p>
 
  <div class="add">
    <input id="in" type="text" maxlength="99" placeholder="Digite o nome da tarefa" aria-label="Nome da tarefa" autocomplete="off">
    <button id="add" class="primary" type="button">Adicionar tarefa</button>
  </div>
  <div id="msg" class="status" role="status" aria-live="polite"></div>
 
  <div class="count"><h2>Minhas tarefas</h2><span id="cnt"></span></div>
  <ul id="list"></ul>
</main>
<script>
(function(){
  var MAX = 100, KEY = "devtasks:v1";
  var tasks = [];
  var $ = function(id){ return document.getElementById(id); };
  var list = $("list"), input = $("in"), msg = $("msg"), cnt = $("cnt"), addBtn = $("add");
 
  try { var raw = localStorage.getItem(KEY); if (raw) tasks = JSON.parse(raw) || []; } catch (e) { tasks = []; }
  if (!Array.isArray(tasks)) tasks = [];
 
  function save(){ try { localStorage.setItem(KEY, JSON.stringify(tasks)); } catch (e) {} }
  function say(text, err){ msg.textContent = text; msg.className = "status" + (err ? " err" : ""); }
 
  function render(){
    list.textContent = "";
    if (!tasks.length){
      var p = document.createElement("li");
      p.className = "empty"; p.style.display = "block";
      p.textContent = "Nenhuma tarefa cadastrada. Digite o nome da tarefa acima para começar.";
      list.appendChild(p);
    }
    tasks.forEach(function(t, i){
      var li = document.createElement("li");
      if (t.done) li.className = "done";
      var n = document.createElement("span"); n.className = "n"; n.textContent = "[" + (i + 1) + "]";
      var box = document.createElement("div");
      var name = document.createElement("span"); name.className = "t"; name.textContent = t.name;
      var st = document.createElement("span"); st.className = "s"; st.textContent = t.done ? "Concluída" : "Pendente";
      box.appendChild(name); box.appendChild(st);
      var acts = document.createElement("div"); acts.className = "acts";
      var c = document.createElement("button"); c.type = "button"; c.textContent = "Concluir"; c.disabled = t.done;
      c.setAttribute("aria-label", "Concluir tarefa " + (i + 1));
      c.onclick = function(){ tasks[i].done = true; save(); render(); say("Tarefa concluída com sucesso!"); };
      var r = document.createElement("button"); r.type = "button"; r.textContent = "Remover";
      r.setAttribute("aria-label", "Remover tarefa " + (i + 1));
      r.onclick = function(){ tasks.splice(i, 1); save(); render(); say("Tarefa removida com sucesso!"); };
      acts.appendChild(c); acts.appendChild(r);
      li.appendChild(n); li.appendChild(box); li.appendChild(acts);
      list.appendChild(li);
    });
    var pend = tasks.filter(function(t){ return !t.done; }).length;
    cnt.textContent = tasks.length + " de " + MAX + " tarefas, " + pend + (pend === 1 ? " pendente" : " pendentes");
    addBtn.disabled = tasks.length >= MAX;
  }
 
  function add(){
    var v = input.value.trim();
    if (tasks.length >= MAX){ say("Limite de tarefas atingido!", true); return; }
    if (!v){ say("Digite um nome para a tarefa.", true); input.focus(); return; }
    tasks.push({ name: v.slice(0, 99), done: false });
    input.value = ""; save(); render(); say("Tarefa cadastrada com sucesso!"); input.focus();
  }
 
  addBtn.onclick = add;
  input.addEventListener("keydown", function(e){ if (e.key === "Enter") add(); });
  render();
})();
</script>
</body>
</html>
